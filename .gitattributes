# One line-ending convention on every platform (Windows, Linux, macOS): LF.
* text=auto eol=lf

# Binary assets: never touch.
*.woff2 binary
*.woff binary
*.png binary
*.jpg binary
*.webp binary

# Windows batch files need CRLF to run reliably in cmd.exe (even when checked out on another system).
*.bat text eol=crlf
*.cmd text eol=crlf
